# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — used by upload/commit routes to bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used to sign the short-lived preview tokens issued by /api/upload/preview.
# Generate with: openssl rand -base64 32
UPLOAD_PREVIEW_SECRET=replace-me-32-bytes-of-randomness

# Optional: name of the Supabase Storage bucket where parsed previews are staged.
UPLOAD_PREVIEW_BUCKET=upload-previews

# Canonical site URL — used to build the magic-link redirect URL. No trailing
# slash. In production, set this to your deployed URL (e.g.
# https://leyton-arena-godine-6161s-projects.vercel.app). In local dev, set
# to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
